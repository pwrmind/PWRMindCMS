<h1>No-Code Engine</h1>
<p>Универсальное хранилище произвольных списков на JSON поверх реляционной СУБД.</p>

<h2>Типы контента
    <a href="?action=content_type_list" style="font-size: .7em; font-weight: normal;">управлять →</a>
</h2>
<?php if (empty($contentTypes)): ?>
    <p><em>Пока нет ни одного типа. <a href="?action=content_type_edit">Создать первый</a>.</em></p>
<?php else: ?>
    <table>
        <tr><th>ID</th><th>Название</th><th>Схема</th></tr>
        <?php foreach ($contentTypes as $ct): ?>
            <tr>
                <td><a href="?action=content_type_edit&id=<?= urlencode($ct['id']) ?>"><?= htmlspecialchars($ct['id'], ENT_QUOTES) ?></a></td>
                <td><?= htmlspecialchars($ct['name'], ENT_QUOTES) ?></td>
                <td><pre><?= htmlspecialchars(json_encode($ct['schema'], JSON_UNESCAPED_UNICODE | JSON_PRETTY_PRINT), ENT_QUOTES) ?></pre></td>
            </tr>
        <?php endforeach; ?>
    </table>
<?php endif; ?>

<h2>Списки
    <a href="?action=list_index" style="font-size: .7em; font-weight: normal;">управлять →</a>
</h2>
<?php if (empty($lists)): ?>
    <p><em>Пока нет ни одного списка. <a href="?action=list_edit">Создать первый</a>.</em></p>
<?php else: ?>
    <table>
        <tr><th>ID</th><th>Название</th><th>Тип контента</th><th>Элементов</th></tr>
        <?php foreach ($lists as $l): ?>
            <tr>
                <td><code><?= htmlspecialchars($l['id'], ENT_QUOTES) ?></code></td>
                <td><a href="?action=entity_list&list_id=<?= urlencode($l['id']) ?>"><?= htmlspecialchars($l['name'], ENT_QUOTES) ?></a></td>
                <td><?= htmlspecialchars($l['content_type_name'] ?? $l['content_type_id'], ENT_QUOTES) ?></td>
                <td><?= (int)$l['item_count'] ?></td>
            </tr>
        <?php endforeach; ?>
    </table>
<?php endif; ?>

<h2>JSON-индексы</h2>
<?php if (empty($indexes)): ?>
    <p><em>Индексы по JSON-полям не созданы.</em></p>
<?php else: ?>
    <ul>
        <?php foreach ($indexes as $ix): ?>
            <li><code><?= htmlspecialchars($ix['list_id'], ENT_QUOTES) ?>.<?= htmlspecialchars($ix['field_name'], ENT_QUOTES) ?></code></li>
        <?php endforeach; ?>
    </ul>
<?php endif; ?>